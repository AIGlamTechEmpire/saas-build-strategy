# Copy this file to .env and fill in the values you need, then run:
#   python scripts/fashion_batch/batch_generate.py --provider krea --limit 2

# --- Krea (https://www.krea.ai) ---
# Get a key from your Krea account settings / API dashboard (docs.krea.ai).
KREA_API_KEY=

# Optional overrides -- defaults shown. See scripts/fashion_batch/README.md
# for which Krea models support multiple reference images.
# KREA_MODEL=google/nano-banana-pro
# KREA_REFERENCE_FIELD=image_urls
# KREA_RESOLUTION=2K

# --- Higgsfield (https://higgsfield.ai) ---
# Either set HF_KEY as "key:secret" from Higgsfield Cloud, or set the two
# halves separately -- only one of these two options is needed.
HF_KEY=
# HF_API_KEY=
# HF_API_SECRET=

# Optional overrides -- defaults shown.
# HIGGSFIELD_MODEL=bytedance/seedream/v4/text-to-image
# HIGGSFIELD_REFERENCE_ARG=image_urls
